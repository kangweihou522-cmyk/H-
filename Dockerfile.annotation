FROM mouse-rnaseq:2-core
# syntax supports a combined system CA mounted when running in a managed cloud.
RUN --mount=type=secret,id=proxy_ca \
    Rscript -e 'if(file.exists("/run/secrets/proxy_ca"))Sys.setenv(CURL_CA_BUNDLE="/run/secrets/proxy_ca"); install.packages("BiocManager", repos="https://cloud.r-project.org"); BiocManager::install("org.Mm.eg.db", version="3.16", ask=FALSE, update=FALSE); stopifnot(requireNamespace("org.Mm.eg.db",quietly=TRUE))'
